{
  "name": "freegma",
  "version": "0.1.22",
  "private": true,
  "type": "module",
  "description": "Local design canvas with editable components, portable workspaces and MCP.",
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/http.mjs",
    "dev": "yarn build && yarn start",
    "test": "node --test tests/*.test.mjs",
    "mcp": "node server/mcp.mjs",
    "examples": "node scripts/create-examples.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
}
