# FREEGMA_DATA_DIR=/absolute/path/freegma-data
# FREEGMA_DB=/absolute/path/freegma-data/freegma.sqlite
# FREEGMA_WORKSPACES=/absolute/path/freegma-data/workspaces
# FREEGMA_BUILD=/absolute/path/dist
# FREEGMA_EMBED_ORIGINS=http://localhost:4320,http://127.0.0.1:4320
# FREEGMA_ORIGIN=http://127.0.0.1:4330
