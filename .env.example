# Optional environment variables; the shell/service sets them (no dotenv required).
FREEGMA_PORT=4330
# FREEGMA_DATA_DIR=/absolute/path/freegma-data
# FREEGMA_DB=/absolute/path/freegma-data/freegma.sqlite
# FREEGMA_WORKSPACES=/absolute/path/freegma-data/workspaces
# FREEGMA_BUILD=/absolute/path/dist
# FREEGMA_EMBED_ORIGINS=http://localhost:4320,http://127.0.0.1:4320
# FREEGMA_ORIGIN=http://127.0.0.1:4330
# FREEGMA_MCP_ORIGINS=https://chatgpt.com
# FREEGMA_PUBLIC_ORIGINS=https://your-freegma.vercel.app
# FREEGMA_PUBLIC_CONFIG=/absolute/path/public-access.json
# FREEGMA_UPSTREAM=https://your-tunnel.trycloudflare.com
